{
  "name": "@shikho/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Confirmed design tokens (color, radius, elevation) for the Shikho Design System, sourced verbatim from the Figma audit \u2014 no inferred or placeholder values.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uchashkhan/shikho-design-system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/Uchashkhan/shikho-design-system/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/Uchashkhan/shikho-design-system/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
