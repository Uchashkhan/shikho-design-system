{
  "name": "@shikho/icons",
  "version": "0.0.0",
  "private": true,
  "description": "Tree-shakeable React icon components for the Shikho Design System, exported verbatim from confirmed Figma glyphs. Currently covers only glyphs confirmed during component audits, not a full icon library.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uchashkhan/shikho-design-system.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/Uchashkhan/shikho-design-system/tree/main/packages/icons#readme",
  "bugs": {
    "url": "https://github.com/Uchashkhan/shikho-design-system/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@shikho/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
